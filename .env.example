FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=replace-with-local-secret
DATABASE_URI=sqlite:///instance/audio_test_platform.sqlite
SEED_DEMO_DATA=true
AI_ENABLED=false
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
