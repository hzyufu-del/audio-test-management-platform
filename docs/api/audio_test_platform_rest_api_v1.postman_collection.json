  "item": [
    {
      "name": "Core demo workflow",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/health",
            "description": "Verify the public, non-sensitive health endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "pm.test(\"Health status is ok\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List TestCases",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/test-cases?page=1&page_size=1",
            "description": "Read one seeded demo TestCase and capture its Version ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Seeded TestCase exists\", function () {",
                  "    pm.expect(body.items.length).to.be.above(0);",
                  "});",
                  "if (body.items.length > 0) {",
                  "    pm.collectionVariables.set(\"version_id\", body.items[0].version_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create TestCase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version_id\": {{version_id}},\n  \"code\": \"TC_POSTMAN_{{mock_suffix}}\",\n  \"title\": \"Sample Postman API TestCase\",\n  \"module\": \"Audio\",\n  \"priority\": \"P2\",\n  \"case_type\": \"checklist\",\n  \"precondition\": \"Use mock device state only.\",\n  \"steps\": \"Run the sample Postman workflow.\",\n  \"expected_result\": \"The sample workflow records a result.\",\n  \"status\": \"draft\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/test-cases",
            "description": "Create a unique mock TestCase."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"mock_suffix\", Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "pm.test(\"Location header is present\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/test-cases/\");",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"test_case_id\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get TestCase",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/test-cases/{{test_case_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
